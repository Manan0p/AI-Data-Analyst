# Docker Compose database settings
POSTGRES_DB=insightforge
POSTGRES_USER=insightforge
POSTGRES_PASSWORD=replace-with-a-local-database-password

# Backend application settings
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
MAX_UPLOAD_MB=25
MAX_ROW_COUNT=500000
LOG_FORMAT=text

# Optional Gemini provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Groq provider
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Optional Upstash Redis chat cache
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_CHAT_TTL_SECONDS=86400
CHAT_CONTEXT_WINDOW=20

# Optional Upstash Vector semantic memory
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
RAG_TOP_K=4
EMBEDDING_MODEL=text-embedding-004

# Optional Sentry monitoring
SENTRY_DSN=
